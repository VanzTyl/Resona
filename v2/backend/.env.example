# Resona Backend Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
DB_HOST=your-tidb-host.tidbcloud.com
DB_PORT=4000
DB_NAME=resona
DB_USER=your-username
DB_PASSWORD=your-password

# Spotify API Credentials
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=https://your-backend.onrender.com/api/auth/spotify/callback

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# Application Configuration
APP_ENV=production
APP_URL=https://your-frontend.netlify.app
CORS_ALLOWED_ORIGIN=https://your-frontend.netlify.app

# Sync Configuration
SYNC_POLL_INTERVAL=120
SYNC_MAX_USERS_PER_RUN=50

# Token Encryption
TOKEN_ENCRYPTION_KEY=