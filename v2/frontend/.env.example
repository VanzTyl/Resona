# Resona Frontend — Environment Configuration
# Copy this to .env and fill in values for local development.
# For Cloudflare Pages, set these in the dashboard Environment Variables.
#
# RESONA_API_URL — URL of the PHP backend (required)
#   Local:   http://localhost:8000
#   Custom:  https://api.yourdomain.com
#   Leave empty to default to same origin.
RESONA_API_URL=
