# Resona Frontend Environment Configuration
# Copy this file to .env before deploying or running locally.

# Backend API base URL
# For local development without ngrok: http://localhost:8000
# For ngrok tunnel: https://abc123.ngrok.io
# For production: https://your-app.onrender.com
RESONA_API_URL=http://localhost:8000

# Application URL (where the frontend is hosted)
# For local dev: http://localhost:3000
# For production: https://your-app.netlify.app
RESONA_APP_URL=http://localhost:3000
